# Include in the existing HTTPS server block. Keep the real token outside Git.
location = /creator-platform {
    return 308 /creator-platform/;
}
location ^~ /creator-platform/ {
    auth_basic "Creator Private Workspace";
    auth_basic_user_file /etc/nginx/quantevo.htpasswd;
    if ($http_origin !~ "^(https://myaistock\\.top)?$") { return 403; }
    proxy_pass http://127.0.0.1:4319/;
    proxy_http_version 1.1;
    proxy_set_header Host myaistock.top;
    proxy_set_header Authorization "";
    proxy_set_header X-Creator-Proxy-Token REPLACE_WITH_PRIVATE_PROXY_TOKEN;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header X-Forwarded-Proto https;
    proxy_set_header X-Forwarded-Prefix /creator-platform;
    proxy_connect_timeout 10s;
    proxy_read_timeout 1800s;
    client_max_body_size 26m;
    gzip on;
    gzip_types application/javascript application/json text/css;
    gzip_min_length 1024;
    gzip_vary on;
}
