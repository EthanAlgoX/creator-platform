{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022"],
    "types": ["node"],
    "allowImportingTsExtensions": false,
    "noEmit": false,
    "rootDir": "server",
    "outDir": "dist/server"
  },
  "include": ["server/**/*.ts"],
  "exclude": ["client", "tests", "node_modules"]
}
